diff --git a/conanfile.py b/conanfile.py
index 6d07285..4fac938 100644
--- a/conanfile.py
+++ b/conanfile.py
@@ -62,6 +62,9 @@ class CuraEngineConan(ConanFile):
             self.version = self.conan_data["version"]
 
     def export(self):
+        # Armada builds from a verified tarball with no .git; its build script writes the pinned commit first.
+        if self.conan_data.get("commit", "unknown") != "unknown":
+            return
         git = Git(self)
         update_conandata(self, {"version": self.version, "commit": git.get_commit()})
 
